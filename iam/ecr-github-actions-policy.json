{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRGetAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ECRPushPullCapstoneRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": [
        "arn:aws:ecr:REGION:us-east-1:381492100137/capstone-demo-dev",
        "arn:aws:ecr:REGION:us-east-1:381492100137/capstone-demo-staging",
        "arn:aws:ecr:REGION:us-east-1:381492100137/capstone-demo-prod"
      ]
    }
  ]
}
